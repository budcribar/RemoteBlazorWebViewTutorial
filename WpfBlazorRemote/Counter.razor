@* The session bar (who has control, Give control / Take control, Copy link, Restart app). RemoteBlazorWebView draws it over this
   placeholder in each browser; in a local run the placeholder stays empty. *@
<div id="rbwv-session-controls" data-share-link="true" data-restart="true"></div>

<h1>Counter</h1>

<p>Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}